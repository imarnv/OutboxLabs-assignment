# ---- Server ----
PORT=4000
NODE_ENV=development
# Where the browser reaches the UI, and the origin OAuth providers redirect back to.
# The Next.js app proxies /api/* to this backend, so both are the frontend origin by default.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Infra (docker compose up -d) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ----
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # optional override

# ---- Slack OAuth (https://api.slack.com/apps) ----
# Scopes: incoming-webhook, chat:write. Slack requires an HTTPS redirect URL, e.g. an ngrok tunnel:
#   SLACK_REDIRECT_URI=https://<your-tunnel>.ngrok-free.app/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=

# ---- Queue / throughput ----
EMAIL_QUEUE_NAME=email-send
WORKER_CONCURRENCY=5
# Minimum gap between two emails from the same sender (ms)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hourly caps enforced atomically in Redis across all workers/instances (0 = unlimited)
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR=200
EMAIL_MAX_ATTEMPTS=3
# Run the worker inside the API process (set false and run `npm run start:worker` separately to scale out)
RUN_WORKER_IN_API=true

# ---- Senders ----
# Number of Ethereal accounts auto-created on first boot (stored in the senders table)
ETHEREAL_SENDER_COUNT=3
# Or pin your own Ethereal/SMTP accounts (JSON array):
# SMTP_SENDERS=[{"name":"Oliver Brown","email":"x@ethereal.email","host":"smtp.ethereal.email","port":587,"user":"x@ethereal.email","pass":"..."}]

# ---- Bull Board (live queue dashboard) ----
BULL_BOARD_PATH=/admin/queues
# Optional basic auth for the dashboard
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
